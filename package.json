{
  "name": "@droppy-ui/design-system",
  "version": "0.3.1",
  "description": "Droppy design system — Svelte components built on Bits UI and the Droppy theme.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yannbf/droppy-ds.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/yannbf/droppy-ds#readme",
  "bugs": "https://github.com/yannbf/droppy-ds/issues",
  "storybook": {
    "url": "https://main--6a6b3f5765e7f685e7f73656.chromatic.com",
    "title": "Droppy Design System"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "terrazzo build && svelte-package -i src -o dist && node scripts/prune-dist.mjs && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "storybook": "terrazzo build && storybook dev -p 6007",
    "build-storybook": "terrazzo build && storybook build --output-dir build/storybook",
    "test": "terrazzo build && vitest",
    "test:ci": "terrazzo build && vitest run",
    "build:tokens": "terrazzo build",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "chromatic": "chromatic --project-token $CHROMATIC_PROJECT_TOKEN --exit-zero-on-changes",
    "release": "changeset publish",
    "experiment:freeze": "tsx tools/storybook-freeze/src/cli.ts",
    "experiment:publish-branches": "tsx tools/storybook-freeze/src/publish-branches.ts",
    "experiment:check": "tsc --noEmit -p tools/storybook-freeze",
    "experiment:test": "vitest run --config tools/storybook-freeze/vitest.config.ts",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "embla-carousel": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@changesets/cli": "^2.31.1",
    "@clack/prompts": "^1.7.0",
    "@component-anatomy/storybook": "^0.1.0",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "11.0.0-alpha.8",
    "@storybook/addon-docs": "11.0.0-alpha.8",
    "@storybook/addon-mcp": "11.0.0-alpha.8",
    "@storybook/addon-vitest": "11.0.0-alpha.8",
    "@storybook/svelte-vite": "11.0.0-alpha.8",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@terrazzo/cli": "^2.7.1",
    "@terrazzo/plugin-css": "^2.7.1",
    "@terrazzo/token-tools": "2.7.1",
    "@types/node": "^26.2.0",
    "@unpunnyfuns/swatchbook-addon": "^2.0.0",
    "@unpunnyfuns/swatchbook-blocks": "^2.0.0",
    "@unpunnyfuns/swatchbook-core": "^2.0.0",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "bits-ui": "^2.20.0",
    "chromatic": "^18.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "11.0.0-alpha.8",
    "eslint-plugin-svelte": "^3.12.0",
    "globals": "^16.5.0",
    "globby": "^16.2.3",
    "jsonc-parser": "^3.3.1",
    "lottie-web": "^5.13.0",
    "magic-string": "^1.2.0",
    "oxc-parser": "^0.144.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "simple-git": "^3.36.0",
    "storybook": "11.0.0-alpha.8",
    "storybook-addon-tag-badges": "^3.1.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "design-system",
    "svelte",
    "bits-ui",
    "components",
    "accessibility"
  ],
  "publishConfig": {
    "access": "public"
  },
  "svelte": "./dist/index.js"
}
